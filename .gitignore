# ==============================================================================
# AI Study Buddy - Enterprise Git Ignore Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# Security, Secrets & Environment Variables (CRITICAL: Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# Databases, Vector Indices & Persistent State
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
**/data/qdrant_db/
**/data/storage/pages/*
!**/data/storage/pages/.gitkeep
**/data/storage/uploads/*
!**/data/storage/uploads/.gitkeep
**/data/storage/audio/*
!**/data/storage/audio/.gitkeep
**/data/*.json
!**/data/.gitkeep
concept_graph.json
graph_communities.json

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/

# Type Checking & Linting
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# Node.js & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
frontend/dist/
dist/
out/
.next/

# ------------------------------------------------------------------------------
# Operating System & IDE Specific
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Agent & Scratch Directory
.agents/
.gemini/
