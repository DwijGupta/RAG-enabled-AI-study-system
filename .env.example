# ==============================================================================
# AI Study Buddy System - Environment Configuration (Lightweight Setup)
# Copy this file to .env and configure your secrets before starting.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Learner-State-Aware RAG Educational Tutor"
VERSION="1.0.0"
DEBUG=true

# Google Gemini Brain & LLM (Google AI Studio)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Storage & Database (SQLite + Embedded Graph & Vector Engine)
DATABASE_URL="sqlite+aiosqlite:///./data/studybuddy.db"
STORAGE_DIR="./data/storage"
DATA_DIR="./data"

# Qdrant Vector Engine
# Leave QDRANT_URL empty to use local embedded Qdrant, or http://localhost:6333 for Docker
QDRANT_URL=""
QDRANT_PATH="./data/qdrant_db"

# Optional External Neo4j (Falls back automatically to embedded NetworkX graph if unavailable)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="studybuddy_graph_pass_2026"

# Optional Observability & Telemetry (Disabled for light use)
LANGFUSE_ENABLED=false
