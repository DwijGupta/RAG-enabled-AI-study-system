# ==============================================================================
# AI Study Buddy System - Environment Configuration
# Copy this file to .env and configure your secrets before starting.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="Learner-State-Aware RAG Educational Tutor"
VERSION="1.0.0"
DEBUG=false

# Google Gemini Brain & LLM (Google AI Studio)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Neo4j Graph Database Credentials (Default Docker service credentials)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="studybuddy_graph_pass_2026"

# Qdrant Vector Engine
QDRANT_URL=""
QDRANT_PATH="./data/qdrant_db"

# Langfuse Observability & Telemetry (Self-Hosted in Docker)
# Web Dashboard: http://localhost:3001
LANGFUSE_PUBLIC_KEY="pk-lf-studybuddy-dev"
LANGFUSE_SECRET_KEY="sk-lf-studybuddy-dev"
LANGFUSE_HOST="http://localhost:3001"
LANGFUSE_ENABLED=true

# Langfuse PostgreSQL Storage Secrets (Zero Data Loss)
LANGFUSE_DB_PASSWORD="studybuddy_secure_pg_pass_2026"
LANGFUSE_NEXTAUTH_SECRET="studybuddy_auth_secret_key_minimum_32_characters"
LANGFUSE_SALT="studybuddy_salt_secret_key_minimum_32_characters"
