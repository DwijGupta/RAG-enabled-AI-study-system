# ==============================================================================
# AI Study Buddy System - Backend Environment Configuration
# ==============================================================================

PROJECT_NAME="Learner-State-Aware RAG Educational Tutor"
VERSION="1.0.0"
DEBUG=false

# Google Gemini Brain & LLM Client (Google AI Studio)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Database & Storage
DATABASE_URL="sqlite+aiosqlite:///./data/studybuddy.db"
STORAGE_DIR="./data/storage"
DATA_DIR="./data"

# Qdrant Vector Store
QDRANT_PATH="./data/qdrant_db"
QDRANT_URL=""
QDRANT_CHUNK_COLLECTION="kb_chunks"
QDRANT_TRACE_COLLECTION="learner_traces"

# Neo4j Graph Database
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="studybuddy_graph_pass_2026"

# Machine Learning Models
EMBEDDING_MODEL="BAAI/bge-m3"
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
NLI_MODEL="cross-encoder/nli-deberta-v3-small"

# Langfuse Observability & Telemetry (Self-Hosted in Docker)
LANGFUSE_PUBLIC_KEY="pk-lf-studybuddy-dev"
LANGFUSE_SECRET_KEY="sk-lf-studybuddy-dev"
LANGFUSE_HOST="http://localhost:3001"
LANGFUSE_ENABLED=true
