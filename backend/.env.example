# ==============================================================================
# AI Study Buddy System - Backend Environment Configuration (Template)
# Copy this file to .env and configure your secrets before starting.
# NEVER commit your actual .env file or credentials to Git!
# ==============================================================================

PROJECT_NAME="Learner-State-Aware RAG Educational Tutor"
VERSION="1.0.0"
DEBUG=false

# ------------------------------------------------------------------------------
# Google Gemini Brain & LLM Client (Google AI Studio)
# Obtain your key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# API Security & Authentication
# ------------------------------------------------------------------------------
# Set API_SECRET_KEY to require X-API-Key or Authorization Bearer header on API requests
API_KEY_AUTH_ENABLED=false
API_SECRET_KEY=""

# Allowed CORS Origins (comma-separated, no wildcards when credentials enabled)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# API Rate Limiting (Sliding Window per IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=30
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------------------------
# Database & Storage
# ------------------------------------------------------------------------------
DATABASE_URL="sqlite+aiosqlite:///./data/studybuddy.db"
STORAGE_DIR="./data/storage"
DATA_DIR="./data"

# Qdrant Vector Store (Leave empty for embedded storage, or specify http://qdrant:6333)
QDRANT_PATH="./data/qdrant_db"
QDRANT_URL=""
QDRANT_CHUNK_COLLECTION="kb_chunks"
QDRANT_TRACE_COLLECTION="learner_traces"

# Neo4j Graph Database (Optional: falls back to embedded NetworkX graph if unavailable)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="studybuddy_graph_pass_2026"

# Machine Learning Models
EMBEDDING_MODEL="BAAI/bge-m3"
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
NLI_MODEL="cross-encoder/nli-deberta-v3-small"

# Observability & Telemetry (Disabled for light use)
LANGFUSE_ENABLED=false
